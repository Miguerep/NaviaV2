## Backend env (FastAPI)
#
# Copy to `backend/.env` and fill values as needed.
# Do NOT commit real secrets.

# App
APP_NAME="Navia Backend"
APP_ENV="development"
APP_PORT=8787

# Database
DATABASE_URL="sqlite:///./backend.db"

# CORS (comma-separated is not supported by pydantic here; keep as Python list in code)
# ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:8787"]'

# Mapbox (optional; existing endpoints use this)
MAPBOX_TOKEN=""

# OpenRouteService (optional alternative routing provider, free tier)
OPENROUTESERVICE_API_KEY=""

